# Porta do servidor
PORT=3001

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://disparazap:changeme@localhost:5432/disparazap?schema=public"

# Segredo para assinar os tokens JWT (use algo longo e aleatório)
JWT_SECRET="troque-por-um-segredo-forte"

# E-mail que recebe privilégios de administrador (opcional)
ADMIN_EMAIL=""

# URL do frontend (CORS)
FRONTEND_URL=http://localhost:3000

# URL base do backend (para links de rastreamento)
BACKEND_URL=http://localhost:3001

# Caminho do Chromium para o Puppeteer (definido automaticamente no Docker).
# Em Windows local pode deixar em branco (usa o Chrome instalado).
PUPPETEER_EXECUTABLE_PATH=

# --- Pagamentos (opcionais) ---
MISTIC_PAY_CLIENT_ID=""
MISTIC_PAY_CLIENT_SECRET=""
MISTIC_PAY_WEBHOOK_URL=""
PIX_KEY=""
PIX_NAME=""
PIX_CITY=""
