{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"options": {
				"env": {
					"NODE_OPTIONS": "--max-old-space-size=4096"
				}
			},
			"isBackground": false,
			"group": "build"
		}
	]
}